name: daddy_template
description: "Flutter AB 包模板工程 - 用于生成可上架 iOS 的 AB 包应用"
publish_to: 'none'

version: 1.0.0+1

environment:
  sdk: ">=3.3.4 <4.0.0"

dependencies:
  flutter:
    sdk: flutter

  cupertino_icons: ^1.0.8

  # 网络请求
  dio: ^5.4.0

  # 本地存储
  shared_preferences: ^2.2.2

  # 设备信息
  device_info_plus: ^12.3.0
  package_info_plus: ^9.0.0

  # 网络连接监控
  connectivity_plus: ^6.0.3

  # AES 加解密（域名列表解密）
  encrypt: ^5.0.3

dev_dependencies:
  flutter_test:
    sdk: flutter

  flutter_lints: ^3.0.0

flutter:
  uses-material-design: true

  # 壳工程自有资源：编译期域名快照（scripts/update_domain_snapshots.sh 拉取覆盖）
  assets:
    - assets/config/test_domains.b64
    - assets/config/staging_domains.b64
    - assets/config/prod_domains.b64
