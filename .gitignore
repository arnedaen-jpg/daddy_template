# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# FVM Version Cache
.fvm/
.claude/
.vscode/

# B-side code (synced from external repo)
lib/modules/secondary/*
!lib/modules/secondary/module_entry.dart
# B 面资源默认忽略；壳工程自有配置资源（assets/config）需保留
assets/*
!assets/config/
plugins/

# Lock files
Podfile.lock
pubspec.lock

# pubspec.yaml (generated from template)
pubspec.yaml.bak

# Backup files
backups/

# Sync config (local paths, developer-specific)
scripts/sync_secondary.conf

# AB config (auto-generated by sync_secondary.sh)
ab_config.yaml
.current_secondary_project
scripts/dart_obfuscator/build

# Obfuscation reports (per-run, project-specific)
scripts/reports/
third_party

# iOS 签名与私钥：勿提交到公共仓库
cert/
sync_secondary.log
ios/**/*.bak
